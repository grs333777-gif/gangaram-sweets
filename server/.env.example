# ─── Environment ───
NODE_ENV=development
PORT=5000

# ─── MongoDB ───
# Standalone local Mongo works for development. Checkout uses a transaction when this
# server is a replica set (Atlas, or mongod started with --replSet rs0).
MONGODB_URI=mongodb://localhost:27017/gangaram_sweets
MONGODB_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ─── JWT ───
JWT_ACCESS_SECRET=change_me_to_a_64_char_random_string_abc123def456ghi789jkl012mno345pqr
JWT_REFRESH_SECRET=change_me_to_another_64_char_random_string_xyz987uvw654tsr321pon098mlk
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=gangaram-sweets-api
JWT_AUDIENCE=gangaram-sweets-client

# ─── Cookies ───
# Leave unset so the cookie matches the site host (localhost or 127.0.0.1).
# COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── CORS ───
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# ─── Razorpay (test keys while developing) ───
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=change_me_to_a_long_random_string
RAZORPAY_BUSINESS_NAME=Gangaram Sweets

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
CHECKOUT_RATE_LIMIT_WINDOW_MS=60000
CHECKOUT_RATE_LIMIT_MAX=5

# ─── Delivery ───
DELIVERY_FEE_PAISE=4000
FREE_DELIVERY_ABOVE_PAISE=50000
MIN_ORDER_AMOUNT_PAISE=20000

# ─── Tax ───
GST_RATE_PERCENT=0

# ─── Serviceability ───
SERVICEABLE_PINCODES=851111,848114,851112,851113

# ─── Logging ───
LOG_LEVEL=debug
LOG_PRETTY=true

# ─── Password Reset ───
PASSWORD_RESET_EXPIRES_MINUTES=30

# ─── Account Lockout ───
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# ─── Cart ───
MAX_CART_ITEM_QUANTITY=20
MAX_CART_ITEMS=50

# ─── Request Body ───
REQUEST_BODY_LIMIT=100kb

# ─── Shop desk ───
# The panel address is the slug in client/.env (VITE_ADMIN_PANEL_SLUG). It is not linked on the site.
ADMIN_EMAIL=gangaram.desk@gangaramsweets.in
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_PHONE=+919100000099
