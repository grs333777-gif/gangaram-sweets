# Get these from Razorpay Dashboard -> Account & Settings -> API Keys
# Use rzp_test_* keys while developing, rzp_live_* ONLY in production env vars (never commit real keys).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard -> Account & Settings -> Webhooks -> (create webhook) -> "Secret"
# This is NOT the API key secret. Make your own long random string (16+ chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAZORPAY_WEBHOOK_SECRET=change_me_to_a_long_random_string

# Shown in the Razorpay checkout popup
RAZORPAY_BUSINESS_NAME=Gangaram

# Also needed by your app (not by this module directly)
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://...
